# Copy to .env.local in this directory. Never commit real credentials.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:3001
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXT_PUBLIC_EXTERNAL_URL=http://localhost:3000
# Public browser configuration for your own Cloudinary account
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_PRESET_NAME=
# Server-side only; required for AI chat in the external app
OPENAI_API_KEY=
