{
  "name": "wedding-management-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:external": "turbo run build --filter=@wedding/external",
    "build:internal": "turbo run build --filter=@wedding/internal",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "generate-api-types": "openapi --input http://localhost:8080/api-json --output ./shared/api && node scripts/update-openapi-config.js",
    "deploy": "sst deploy --stage production",
    "test:auth": "node --test scripts/auth-smoke.test.mjs"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "openapi-typescript-codegen": "^0.29.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sst": "^4.17.2",
    "turbo": "^2.3.0",
    "typescript": "^5"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.42",
    "@ai-sdk/react": "^2.0.60",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^5.0.60",
    "cloudinary": "^2.7.0",
    "cookies-next": "^6.1.0",
    "dotenv": "^17.2.2",
    "embla-carousel-react": "^8.6.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.12",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.540.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.11",
    "next-cloudinary": "^7.1.0",
    "next-themes": "^0.4.6",
    "openai": "^6.49.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react-pageflip": "^2.0.3",
    "react-swipeable": "^7.0.2",
    "react-to-print": "^3.1.1",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2",
    "zustand": "^5.0.8",
    "zod": "^4.6.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "undici": "^6.29.1",
    "@fastify/busboy": "^3.2.2",
    "minimatch@>=7 <11": "^11.0.1"
  }
}
